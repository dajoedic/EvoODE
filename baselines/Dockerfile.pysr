FROM python:3.11-slim

WORKDIR /workspace/EvoODE

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/EvoODE \
    JULIA_DEPOT_PATH=/opt/pysr-julia \
    PYTHON_JULIAPKG_PROJECT=/opt/pysr-julia/pysr-env \
    PYTHON_JULIAPKG_OFFLINE=no \
    JULIA_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1

LABEL org.opencontainers.image.title="EvoODE PySR baseline" \
      org.opencontainers.image.description="PySR 1.5.9 baseline with JuliaCall/JuliaPkg backend preinstalled at build time" \
      org.evoode.pysr.version="1.5.9" \
      org.evoode.pysr.symbolic_regression_constraint="~1.11.0"

RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY baselines/requirements-pysr.txt /tmp/requirements-pysr.txt
RUN pip install --no-cache-dir -r /tmp/requirements-pysr.txt

RUN python - <<'PY'
import json
from pathlib import Path

import pysr
from pysr import jl

metadata_path = Path("/opt/evoode-pysr-image-metadata.json")
metadata_path.parent.mkdir(parents=True, exist_ok=True)
metadata = {
    "pysr": getattr(pysr, "__version__", "unknown"),
    "julia": str(jl.VERSION),
    "symbolic_regression_jl": str(
        jl.seval(
            'import Pkg; string(Pkg.dependencies()[Base.UUID("8254be44-1295-4e6a-a16d-46603ac705cb")].version)'
        )
    ),
    "julia_depot_path": "/opt/pysr-julia",
    "juliapkg_project": "/opt/pysr-julia/pysr-env",
}
metadata_path.write_text(json.dumps(metadata, sort_keys=True) + "\n", encoding="utf-8")
print(metadata_path.read_text(encoding="utf-8"), end="")
PY

ENV PYTHON_JULIAPKG_OFFLINE=yes \
    JULIA_PKG_OFFLINE=true

COPY . /workspace/EvoODE

ENTRYPOINT ["python", "-m", "baselines.run_pysr_noise"]
