FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1
WORKDIR /workspace/EvoODE
COPY baselines/requirements-sindy-baselines.txt /tmp/requirements-sindy-baselines.txt
COPY baselines/requirements-qb2-weakident.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY analysis/ /workspace/EvoODE/analysis/
COPY baselines/run_weakident_c6.py /workspace/EvoODE/baselines/run_weakident_c6.py
COPY baselines/third_party/weakident/ /workspace/EvoODE/baselines/third_party/weakident/
COPY baselines/third_party/numpy_indexed_pkg/ /workspace/EvoODE/baselines/third_party/numpy_indexed_pkg/
COPY benchmarks/data/strogatz_extended.json /workspace/EvoODE/benchmarks/data/strogatz_extended.json
COPY studies/regression/phase_c_support.json /workspace/EvoODE/studies/regression/phase_c_support.json
ENTRYPOINT ["python", "baselines/run_weakident_c6.py", "shard"]
